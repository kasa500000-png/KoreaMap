{
  "name": "korea-map-styles",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Korea Map Kit styles foundation",
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "korea-map-core": "workspace:*",
    "@maplibre/maplibre-gl-style-spec": "26.4.4",
    "@types/geojson": "7946.0.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kasa500000-png/KoreaMap.git",
    "directory": "packages/styles"
  },
  "homepage": "https://github.com/kasa500000-png/KoreaMap",
  "bugs": {
    "url": "https://github.com/kasa500000-png/KoreaMap/issues"
  },
  "keywords": [
    "maplibre",
    "korea",
    "map",
    "typescript",
    "styles"
  ]
}
