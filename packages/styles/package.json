{
  "name": "@korea-map-kit/styles",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Korea Map Kit styles foundation",
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
