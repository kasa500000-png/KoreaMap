      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@korea-map-kit/core": "workspace:*",
    "@maplibre/maplibre-gl-style-spec": "26.4.4"
  }
}
