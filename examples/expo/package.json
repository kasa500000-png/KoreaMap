{
  "name": "@korea-map-kit/example-expo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node ../../scripts/run-tool.mjs expo export --platform android --platform ios --output-dir dist --no-bytecode",
    "dev": "node ../../scripts/run-tool.mjs expo start --offline --localhost",
    "typecheck": "tsc --noEmit",
    "android": "node ../../scripts/run-tool.mjs expo run:android",
    "ios": "node ../../scripts/run-tool.mjs expo run:ios"
  },
  "dependencies": {
    "@korea-map-kit/core": "workspace:*",
    "@korea-map-kit/data-adapters": "workspace:*",
    "@korea-map-kit/native": "workspace:*",
    "@maplibre/maplibre-react-native": "11.5.0",
    "expo": "58.0.14",
    "expo-location": "58.0.17",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/react": "19.3.0"
  },
  "main": "index.js"
}
