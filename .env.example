# No key or endpoint is required for local fixture builds/tests.
# Never put secrets in NEXT_PUBLIC_* / EXPO_PUBLIC_* or commit operator values.
# This template is documentation only; SDK configuration is passed explicitly.

# Optional PRIVATE geo-data service configuration (never NEXT_PUBLIC_/EXPO_PUBLIC_).
# geo:local start generates ignored artifacts/geo-dev/.env for local development.
GEO_DATABASE_URL=
KMK_IMPORT_CONFIG=
KMK_SOURCE_FILE=
KMK_DOWNLOAD_URL=
KMK_POI_PORT=8099
KMK_SEARCH_PORT=8100
