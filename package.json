{
  "name": "korea-map-kit-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "build": "node scripts/tasks.mjs build",
    "build:sdk": "node scripts/tasks.mjs sdk",
    "typecheck": "node scripts/tasks.mjs typecheck",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/tasks.mjs check",
    "clean": "node scripts/tasks.mjs clean",
    "dev:web": "node scripts/tasks.mjs dev-web",
    "dev:expo": "node scripts/tasks.mjs dev-expo",
    "test:web": "playwright test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docs": "node scripts/python.mjs scripts/check-design.py",
    "audit:cost": "node scripts/python.mjs scripts/audit-cost-security.py",
    "test:audit": "node scripts/python.mjs scripts/test-cost-audit.py",
    "pack:check": "node scripts/pack-check.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "offline:check": "node scripts/offline-install-check.mjs",
    "check:data": "node scripts/python.mjs scripts/check-data.py",
    "test:data": "node scripts/python.mjs scripts/test-data-policy.py",
    "docs:data": "node scripts/python.mjs scripts/render-data-docs.py",
    "check:data-docs": "node scripts/python.mjs scripts/render-data-docs.py --check",
    "test:core": "pnpm exec tsc -b packages/core && node --test tests/core-independent.test.mjs",
    "docs:api": "pnpm exec tsc -b packages/core && node scripts/render-api-docs.mjs",
    "check:api-docs": "node scripts/render-api-docs.mjs --check",
    "check:native-types": "node scripts/check-native-types.mjs",
    "geo:local": "node scripts/geo-local.mjs",
    "geo": "node --env-file-if-exists=artifacts/geo-dev/.env services/geo-data/dist/cli.js",
    "geo:migrate": "pnpm geo migrate",
    "geo:fixture": "pnpm geo fixture",
    "geo:serve": "pnpm geo serve",
    "test:geo": "pnpm build:sdk && node scripts/geo-local.mjs test",
    "search:service": "node --env-file-if-exists=artifacts/geo-dev/.env services/search/dist/cli.js",
    "search:migrate": "pnpm search:service migrate",
    "search:serve": "pnpm search:service serve",
    "routing:local": "node scripts/routing-local.mjs",
    "routing:serve": "node services/routing/dist/cli.js",
    "test:routing": "pnpm build:sdk && node scripts/routing-local.mjs test",
    "check:licenses": "node scripts/check-licenses.mjs",
    "audit:dependencies": "pnpm audit --audit-level=high",
    "verify:packages": "node scripts/verify-packages.mjs",
    "test:release": "node --test tests/release.test.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:verify": "node scripts/release.mjs verify",
    "tiles": "node --use-env-proxy services/tiles/dist/cli.js",
    "test:tiles": "node --test tests/tiles.test.mjs tests/tiles-security.test.mjs tests/tiles-v2.test.mjs tests/tiles-http-v2.test.mjs",
    "test:native-consumer": "node --test tests/native-consumer.test.mjs",
    "verify:native-consumer": "node scripts/verify-native-consumer.mjs",
    "test:real-poi": "node --test tests/real-poi.test.mjs",
    "verify:real-poi": "node scripts/verify-real-poi.mjs",
    "test:tile-glyphs": "node scripts/python.mjs tests/tile-glyphs.test.py",
    "test:tile-profile": "node services/tiles/profile/verify-profile.mjs",
    "test:real-tiles": "node --test tests/real-tiles.test.mjs",
    "verify:real-tiles": "node scripts/verify-real-tiles.mjs",
    "verify:real-routing-map": "node scripts/verify-real-routing-map.mjs",
    "test:map-quality": "node --test tests/map-quality.test.mjs tests/quality-consumer.test.mjs",
    "verify:map-quality": "node scripts/verify-map-quality.mjs",
    "verify:map-frames": "node scripts/verify-map-frames.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2",
    "prettier": "3.9.10",
    "vitest": "5.0.5",
    "vite": "8.3.4",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@playwright/test": "1.64.1",
    "@maplibre/maplibre-gl-style-spec": "26.4.4",
    "korea-map-core": "workspace:*",
    "korea-map-web": "workspace:*",
    "korea-map-styles": "workspace:*",
    "korea-map-data-adapters": "workspace:*",
    "maplibre-gl": "6.14.0"
  }
}
